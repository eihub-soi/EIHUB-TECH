{
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{frontend/**,node_modules/**,backend/.venv/**,backend/__pycache__/**,database/**,docker/**,.git/**,.wrangler/**,scripts/**,docs/**,scratch/**,test-results/**,.pytest_cache/**,*.db,*.sqlite}"
    }
  },
  "rewrites": [
    {
      "source": "/api-brevo/:path*",
      "destination": "https://api.brevo.com/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api-brevo|api|assets|manifest.json|sw.js|logo.png|avatars|favicon.ico|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}
